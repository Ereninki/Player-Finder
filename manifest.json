{
    "display_information": {
        "name": "PlayerFinder",
        "description": "The Ultimate Player Info giver in #minecraft",
        "background_color": "#000000"
    },
    "features": {
        "bot_user": {
            "display_name": "PlayerFinder",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/player",
                "description": "lookup someone from hc mc server!!",
                "usage_hint": "lookup <@slack_mention>",
                "should_escape": true
            },
            {
                "command": "/api-health",
                "description": "health of the hccore api",
                "should_escape": false
            },
            {
                "command": "/server-status",
                "description": "shows server status!!",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "groups:history",
                "app_mentions:read",
                "channels:history",
                "chat:write",
                "commands",
                "groups:read",
                "groups:write"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}